/* --- Ретро-терминал стиль --- */
QMainWindow {
    background-color: #050505;
}

QTextEdit#screenOutput {
    background-color: #000000;
    color: #33ff33;
    font-family: "Courier New", "Consolas", "Monaco", monospace;
    font-size: 14px;
    border: 2px solid #1a4d1a;
    selection-background-color: #33ff33;
    selection-color: #000000;
    padding: 10px;
}

QLineEdit#commandInput {
    background-color: #000000;
    color: #33ff33;
    font-family: "Courier New", "Consolas", "Monaco", monospace;
    font-size: 14px;
    border: 2px solid #1a4d1a;
    border-top: none;
    padding: 8px;
}

QLineEdit#commandInput:focus {
    border: 2px solid #33ff33;
}

QScrollBar:vertical {
    border: none;
    background: #001100;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1a4d1a;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #33ff33;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* --- Состояния для эффекта мигания (CRT) --- */

/* Лёгкое мигание */
QTextEdit#screenOutput[flickerState="light"] {
    background-color: #001100;
    color: #22CC22;
    border: 2px solid #1a4d1a;
}

/* Сильное дрожание */
QTextEdit#screenOutput[flickerState="strong"] {
    background-color: #000000;
    color: #11AA11;
    border: 2px solid #0d260d;
}
